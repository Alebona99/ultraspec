#!/usr/bin/env bash
# ultraspec — universal fallback adapter (git pre-commit)
#
# Installed on EVERY harness in addition to the native adapter. Even where a
# harness cannot reliably intercept a single file write, a `git commit` made in a
# phase that does not allow commits will fail here.
#
# This is a TEMPLATE: install.sh generates the real hook from this file,
# substituting the placeholder below with the absolute path to the package's
# own dist/cli.js at install time.
#
# Self-locating: walks up from the repo root looking for ultraspec/.
set -u

ULTRASPEC_CLI_JS="@@ULTRASPEC_CLI_JS@@"

find_us_root() {
  local dir; dir="$(pwd)"
  while [ -n "$dir" ]; do
    [ -f "$dir/ultraspec/us.config.json" ] && return 0
    [ "$dir" = "/" ] && break
    dir="$(dirname "$dir")"
  done
  return 1
}

find_us_root || exit 0   # ultraspec not present in this repo -> no-op

if command -v us >/dev/null 2>&1; then
  us_cli() { us "$@"; }
else
  us_cli() { node "$ULTRASPEC_CLI_JS" "$@"; }
fi

payload="$(printf '{"command":"git commit","cwd":"%s"}' "$(pwd)")"

if ! out="$(printf '%s' "$payload" | us_cli hook generic-git gate 2>&1)"; then
  printf 'ultraspec: commit bloccato\n' >&2
  [ -n "$out" ] && printf '%s\n' "$out" >&2
  printf 'ultraspec: usa /ultraspec:advance per raggiungere una fase in cui il commit e'\'' consentito, oppure --no-verify per forzare (sconsigliato).\n' >&2
  exit 1
fi
exit 0
