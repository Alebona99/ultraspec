{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ultraspec/state.schema.json",
  "title": "ultraspec workflow state",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow", "track", "phase", "phases_done", "gates", "session_log", "history", "updated_at"],
  "properties": {
    "workflow": { "type": "string", "minLength": 1 },
    "track": { "enum": ["greenfield", "brownfield"] },
    "phase": { "enum": ["intake", "discover", "spec", "plan", "build", "review", "archive", "done"] },
    "phases_done": {
      "type": "array",
      "items": { "enum": ["intake", "discover", "spec", "plan", "build", "review", "archive"] }
    },
    "harness": { "type": ["string", "null"] },
    "artifacts_dir": { "type": ["string", "null"] },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requires", "requires_approval", "human_approved"],
        "properties": {
          "requires": { "type": "array", "items": { "type": "string" } },
          "requires_approval": { "type": "boolean" },
          "human_approved": { "type": "boolean" }
        }
      }
    },
    "session_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "session_id", "event", "note"],
        "properties": {
          "at": { "type": "string" },
          "session_id": { "type": ["string", "null"] },
          "event": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "last_handoff_at": { "type": ["string", "null"] },
    "last_session_id": { "type": ["string", "null"] },
    "last_session_at": { "type": ["string", "null"] },
    "nudge_marker": { "type": ["string", "null"] },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "event"],
        "properties": {
          "at": { "type": "string" },
          "event": { "type": "string" },
          "from": { "type": ["string", "null"] },
          "to": { "type": ["string", "null"] },
          "reason": { "type": ["string", "null"] },
          "gate": { "type": ["string", "null"] }
        }
      }
    },
    "updated_at": { "type": "string" }
  }
}
