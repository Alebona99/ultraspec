#!/usr/bin/env bash
# ultraspec — state-machine CLI (backing implementation for the /ultraspec:* commands)
#
#   us start <name> --track greenfield|brownfield [--harness H]
#   us approve <phase>                 # USER ONLY
#   us advance                         # forward only; validates the current gate
#   us reopen <phase> --reason "..."   # backward; logged
#   us set-track greenfield|brownfield # only in intake/discover
#   us status [--json]
#   us board                           # overview: workflow + artifacts + tests + handoffs + history
#   us handoff-path                    # echo where the next handoff file goes
#   us handoff-done <file>             # stamp last_handoff_at
#
# All writes go through hooks/lib/us-state.sh so history/session_log stay intact.
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
LIB="$HERE/../hooks/lib"
. "$LIB/us-state.sh"
. "$LIB/us-decision.sh"
. "$LIB/us-context.sh"

die() { printf 'us: %s\n' "$*" >&2; exit 1; }
need_env() { us_env "${US_CWD:-$PWD}" || die "nessun ultraspec/us.config.json trovato risalendo da $PWD"; }
need_active() { us_state_active || die "nessun workflow attivo (usa: /ultraspec:start <nome> --track ...)"; }

_gates_from_config() {
  jq -c '.gates | to_entries | map({key:.key, value:{requires:.value.requires, requires_approval:.value.requires_approval, human_approved:false}}) | from_entries' "$US_CONFIG"
}
_phase_after() { jq -r --arg p "$1" '.phase_order[((.phase_order|index($p))+1)] // empty' "$US_CONFIG"; }
_phase_le() { local a b; a="$(us_phase_index "$1")"; b="$(us_phase_index "$2")"; [ "$a" -ge 0 ] && [ "$b" -ge 0 ] && [ "$a" -le "$b" ]; }
_workflows_dir() { printf '%s/%s\n' "$US_ROOT" "$(us_cfg '.workflows_dir' 'ultraspec/workflows')"; }

cmd_start() {
  local name="" track="" harness=""
  name="${1:-}"; shift || true
  while [ $# -gt 0 ]; do case "$1" in
    --track) track="$2"; shift 2;;
    --harness) harness="$2"; shift 2;;
    *) die "opzione sconosciuta: $1";;
  esac; done
  [ -n "$name" ] || die "manca il nome del workflow"
  case "$track" in greenfield|brownfield) ;; *) die "track mancante o non valido: usa --track greenfield|brownfield";; esac
  need_env
  [ -f "$US_STATE_FILE" ] && us_state_active && die "esiste già un workflow attivo: $(us_state_get .workflow) (fase $(us_state_get .phase)). Chiudilo con /ultraspec:archive o usa un git worktree."
  local reldir; reldir="$(us_cfg '.workflows_dir' 'ultraspec/workflows')/$name"
  mkdir -p "$US_ROOT/$reldir"
  local now; now="$(us_now)"
  jq -n --arg wf "$name" --arg tk "$track" --arg h "$harness" --arg now "$now" \
     --argjson gates "$(_gates_from_config)" --arg adir "$reldir" '
    { workflow:$wf, track:$tk, phase:"intake", phases_done:[],
      harness:($h|select(.!="")//null), artifacts_dir:$adir,
      gates:$gates, session_log:[], last_handoff_at:null, last_session_id:null,
      last_session_at:null, nudge_marker:null,
      history:[{at:$now, event:"start", from:null, to:"intake"}], updated_at:$now }' \
    | us_state_write
  printf 'workflow "%s" avviato — track=%s, fase=intake, artefatti in %s/\nProssimo: /ultraspec:discover\n' "$name" "$track" "$reldir"
}

cmd_set_track() {
  local track="${1:-}"
  case "$track" in greenfield|brownfield) ;; *) die "uso: /ultraspec:set-track greenfield|brownfield";; esac
  need_env; need_active
  local ph cur; ph="$(us_state_get .phase)"; cur="$(us_state_get .track)"
  [ "$track" = "$cur" ] && { printf 'track già "%s"\n' "$track"; return 0; }
  case "$ph" in
    intake|discover) ;;
    *) die "il track si cambia solo in intake/discover (ora: $ph). Influenza solo la fase discover; oltre non ha effetto. Se devi rifare la discovery: /ultraspec:reopen discover --reason \"...\"." ;;
  esac
  us_state_patch '.track = $t' --arg t "$track"
  echo '{"event":"set-track","from":"'"$cur"'","to":"'"$track"'"}' | us_state_history
  printf 'track: %s -> %s — rilancia /ultraspec:discover\n' "$cur" "$track"
}

# overview of everything pending: workflow, artifacts, tests, handoffs, history
cmd_board() {
  need_env
  cmd_status || true
  local wdir; wdir="$(_workflows_dir)"

  printf '\n--- Workflow attivo: artefatti ---\n'
  if us_state_active; then
    local adir; adir="$US_ROOT/$(us_state_get .artifacts_dir)"
    if [ -d "$adir" ]; then
      ( cd "$adir" && for f in *.md; do [ -e "$f" ] && printf '  [x] %s\n' "$f"; done )
      for req in $(jq -r '.gates[].requires[]?' "$US_CONFIG" | sort -u); do
        [ -e "$adir/$req" ] || printf '  [ ] %s  (richiesto da un gate)\n' "$req"
      done
    else
      printf '  (cartella %s non ancora creata)\n' "$(us_state_get .artifacts_dir)"
    fi
  fi

  printf '\n--- Tutti i workflow ---\n'
  if [ -d "$wdir" ]; then
    ( cd "$wdir" && for d in */; do [ -d "$d" ] && printf '  - %s  (%s file)\n' "${d%/}" "$(ls -1 "$d"*.md 2>/dev/null | wc -l | tr -d ' ')"; done )
  else
    printf '  nessuno\n'
  fi

  printf '\n--- Test ---\n'
  [ -x "$US_DIR/tests/run.sh" ] && printf '  ultraspec:  bash ultraspec/tests/run.sh\n'
  for c in "package.json:npm test" "pnpm-lock.yaml:pnpm test" "pyproject.toml:pytest" "go.mod:go test ./..." "Cargo.toml:cargo test"; do
    [ -f "$US_ROOT/${c%%:*}" ] && printf '  progetto:     %s\n' "${c#*:}"
  done

  printf '\n--- Handoff ---\n'
  local hdir; hdir="$US_ROOT/$(us_cfg '.handoffs_dir' 'ultraspec/handoffs')"
  ls -1t "$hdir"/*-*.md 2>/dev/null | head -3 | sed "s#$US_ROOT/#  #" || printf '  nessuno\n'

  printf '\n--- History (ultimi eventi) ---\n'
  us_state_read | jq -r '.history[-8:][]? |
    "  \(.at)  \(.event)\(if .from then " "+.from else "" end)\(if .to then " -> "+.to else "" end)\(if .reason then "  («\(.reason)»)" else "" end)"' 2>/dev/null
}

cmd_approve() {
  local phase="${1:-}"
  [ -n "$phase" ] || die "uso: /ultraspec:approve <phase>"
  need_env; need_active
  jq -e --arg p "$phase" '.gates[$p]' <<<"$(us_state_read)" >/dev/null 2>&1 || die "la fase '$phase' non ha un gate da approvare"
  us_state_patch '.gates[$p].human_approved = true' --arg p "$phase" || die "scrittura fallita"
  echo '{"event":"approve","gate":"'"$phase"'"}' | us_state_history
  printf 'gate "%s" approvato dall'\''utente. Ora puoi /ultraspec:advance quando gli artefatti sono pronti.\n' "$phase"
}

cmd_advance() {
  need_env; need_active
  local cur nxt
  cur="$(us_state_get .phase)"
  nxt="$(_phase_after "$cur")"
  [ -n "$nxt" ] || die "sei già alla fase finale ('$cur')"

  local missing
  missing="$(us_missing_artifacts "$cur" | paste -sd, - | sed 's/,/, /g')"
  [ -n "$missing" ] && die "avanzamento rifiutato: mancano gli artefatti del gate '$cur': $missing"

  if [ "$(us_cfg ".gates.\"$cur\".requires_approval" false)" = "true" ]; then
    [ "$(us_state_get ".gates.\"$cur\".human_approved")" = "true" ] \
      || die "avanzamento rifiutato: il gate '$cur' richiede l'approvazione dell'utente (/ultraspec:approve $cur). /ultraspec:advance non approva."
  fi

  us_state_patch '
    .phases_done += (if (.phases_done | index($cur)) then [] else [$cur] end)
    | .phase = $nxt
    | .nudge_marker = null
  ' --arg cur "$cur" --arg nxt "$nxt"
  echo '{"event":"advance","from":"'"$cur"'","to":"'"$nxt"'"}' | us_state_history
  printf 'avanzato: %s -> %s\n' "$cur" "$nxt"
}

cmd_reopen() {
  local phase="" reason=""
  phase="${1:-}"; shift || true
  while [ $# -gt 0 ]; do case "$1" in
    --reason) reason="$2"; shift 2;;
    *) die "opzione sconosciuta: $1";;
  esac; done
  [ -n "$phase" ] || die "uso: /ultraspec:reopen <phase> --reason \"...\""
  [ -n "$reason" ] || die "reopen richiede --reason \"...\" (viene registrato nella history)"
  need_env; need_active
  local cur; cur="$(us_state_get .phase)"
  us_phase_index "$phase" | grep -q '^-1$' && die "fase sconosciuta: $phase"
  _phase_le "$phase" "$cur" || die "reopen va solo indietro: '$phase' non precede '$cur'"

  us_state_patch '
    ($order | index($p)) as $pi
    | .phase = $p
    | .phases_done = [ .phases_done[] | . as $x | select( ($order | index($x)) < $pi ) ]
    | .gates = ( [ .gates | to_entries[]
                   | . as $e | ($order | index($e.key)) as $gi
                   | if ($gi == null or $gi >= $pi) then (.value.human_approved = false) else . end
                 ] | from_entries )
  ' --arg p "$phase" --argjson order "$(jq -c '.phase_order' "$US_CONFIG")"
  echo '{"event":"reopen","from":"'"$cur"'","to":"'"$phase"'","reason":"'"${reason//\"/\'}"'"}' | us_state_history
  printf 'riaperto: %s -> %s (motivo registrato)\n' "$cur" "$phase"
}

cmd_status() {
  need_env
  if ! us_state_active; then
    echo "nessun workflow attivo. Avvia con: /ultraspec:start <nome> --track greenfield|brownfield"
    return 0
  fi
  local ph harness enforce
  ph="$(us_state_get .phase)"; harness="$(us_state_get .harness)"
  enforce="$(us_enforcement_level "$harness")"
  if [ "${1:-}" = "--json" ]; then
    local miss; miss="$(us_missing_artifacts "$ph" | jq -R . | jq -s .)"
    us_state_read | jq --arg enf "$enforce" --argjson miss "$miss" \
      '{workflow,track,phase,phases_done, missing_artifacts:$miss, gates, harness, enforcement:$enf}'
    return 0
  fi
  printf 'workflow : %s\n' "$(us_state_get .workflow)"
  printf 'track    : %s\n' "$(us_state_get .track)"
  printf 'fase     : %s   (fatte: %s)\n' "$ph" "$(us_state_get '.phases_done | join(", ")')"
  printf 'harness  : %s   enforcement: %s\n' "${harness:-?}" "$enforce"
  local missing; missing="$(us_missing_artifacts "$ph" | paste -sd, - | sed 's/,/, /g')"
  if [ -n "$missing" ]; then printf 'gate     : mancano %s\n' "$missing"
  elif jq -e --arg p "$ph" '.gates[$p]' "$US_CONFIG" >/dev/null 2>&1; then
    if us_gate_approved "$ph"; then printf 'gate     : soddisfatto — /ultraspec:advance\n'
    else printf 'gate     : artefatti pronti, manca /ultraspec:approve %s\n' "$ph"; fi
  else printf 'gate     : nessun gate per questa fase — /ultraspec:advance\n'; fi
  if ! us_phase_allows_code; then
    printf 'blocco   : modifiche a codice di prodotto bloccate fino alla fase "%s"; commit consentito in %s\n' \
      "$(us_cfg '.code_edit_allowed_from' build)" "$(us_cfg '.commit_allowed_phases | join(", ")')"
  fi
}

us_enforcement_level() { # <harness>
  local h="$1" f="$US_DIR/adapters/SUPPORT.md" line
  [ -n "$h" ] && [ -f "$f" ] || { echo "sconosciuto"; return; }
  line="$(grep -iE "^\| *$h *\|" "$f" | head -n1)"
  [ -z "$line" ] && { echo "solo fallback git (adapter non elencato)"; return; }
  if printf '%s' "$line" | grep -q 'X.*X.*X.*X'; then echo "completo (write + commit + contesto + turn-end)"
  elif printf '%s' "$line" | grep -q 'X.*X'; then echo "parziale (vedi adapters/SUPPORT.md)"
  else echo "minimo (solo fallback git)"; fi
}

cmd_handoff_path() {
  need_env; need_active
  local dir wf ts
  dir="$US_ROOT/$(us_cfg '.handoffs_dir' 'ultraspec/handoffs')"
  wf="$(us_state_get .workflow)"
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p "$dir"
  printf '%s/%s-%s.md\n' "$dir" "$wf" "$ts"
}

cmd_handoff_done() {
  local f="${1:-}"
  [ -f "$f" ] || die "file di handoff non trovato: $f"
  need_env; need_active
  us_state_patch '.last_handoff_at = $at' --arg at "$(us_now)"
  printf 'handoff registrato: %s\n' "$(basename "$f")"
}

sub="${1:-}"; shift || true
case "$sub" in
  start)   cmd_start "$@" ;;
  approve) cmd_approve "$@" ;;
  advance) cmd_advance "$@" ;;
  reopen)  cmd_reopen "$@" ;;
  status)  cmd_status "$@" ;;
  board|overview) cmd_board "$@" ;;
  set-track) cmd_set_track "$@" ;;
  handoff-path) cmd_handoff_path "$@" ;;
  handoff-done) cmd_handoff_done "$@" ;;
  ""|-h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "sotto-comando sconosciuto: $sub" ;;
esac
